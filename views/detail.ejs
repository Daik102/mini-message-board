<%- include('partials/header', { title }) %>
<main>
  <h1>Mini Message Board</h1>
    <div class="detail-container">
      <p class="detail-name"><%= message.user %></p>
      <p class="detail-date"><%= message.added.toLocaleString('ja-JP', { dateStyle: 'medium', timeStyle: 'long', timeZone: 'Asia/Tokyo' }) %></p>
      <p class="detail-message">"<%= message.text %>"</p>
      <a href="/">Back</a>
    </div>
</main>
<%- include('partials/footer') %>
