<form method="POST" action="/new">
    <h2>New Message</h2>
    <div>
      <label for="name">Name:</label>
      <input type="text" id="name" name="name">
    </div>
    <div>
      <label for="message">Message:</label>
      <input type="text" id="message" name="message">
    </div>
    <button type="submit">Submit</button>
  </form>
