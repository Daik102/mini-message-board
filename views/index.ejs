<%- include('partials/header', { title }) %>
<main>
  <h1>Mini Message Board</h1>
  <ul>
    <% messages.forEach((message, i) => { %>
      <li>
        <a href="/message/<%= i %>">
          <div>
            <p class="user-name"><%= message.user %></p>
            <p class="user-date"><%= message.added.split(',')[1] %></p>
          </div>
          <p class="user-message"><%= message.text %></p>
        </a>
      </li>
    <% }); %>
  </ul>
</main>
<%- include('partials/footer') %>
